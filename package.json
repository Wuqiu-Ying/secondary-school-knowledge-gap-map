{
  "name": "secondary-school-knowledge-gap-map",
  "productName": "中学知识漏洞图谱",
  "version": "0.1.0",
  "description": "Local-first AI knowledge-gap map for secondary-school students. 中学知识漏洞图谱。",
  "author": "Wuqiu-Ying",
  "private": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "selftest": "node scripts/selftest.mjs",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --win --dir -c.electronDist=node_modules/electron/dist -c.win.signAndEditExecutable=false && npm run icon:apply",
    "package:portable": "npm run dist:dir",
    "cap:init": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "icon:apply": "node scripts/apply-icon.mjs release/win-unpacked/中学知识漏洞图谱.exe"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8",
    "resedit": "^3.1.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "cn.aiedu.xueqing",
    "productName": "中学知识漏洞图谱",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "中学知识漏洞图谱"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wuqiu-Ying/secondary-school-knowledge-gap-map.git"
  },
  "homepage": "https://github.com/Wuqiu-Ying/secondary-school-knowledge-gap-map",
  "bugs": {
    "url": "https://github.com/Wuqiu-Ying/secondary-school-knowledge-gap-map/issues"
  }
}
